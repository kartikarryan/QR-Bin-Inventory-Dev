# ===== .NET / backend =====
backend/**/bin/
backend/**/obj/
backend/**/.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.pfx
*.publishsettings
**/publish/
**/PublishProfiles/*.pubxml.user

# Real local/production secrets — never commit these. Templates (.example) stay tracked.
backend/QrBin.Api/appsettings.Development.json
backend/QrBin.Api/appsettings.Production.json
backend/QrBin.Api/appsettings.*.Local.json
backend/**/secrets.json

# ===== Angular / frontend =====
# (frontend/ already has its own .gitignore; this is a safety net if anything is ever
# added or moved above that folder)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/npm-debug.log*
frontend/yarn-error.log*

# ===== Deployment (Vercel / Render) =====
.vercel
.env
.env.local
.env.*.local

# ===== Editors / OS =====
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
